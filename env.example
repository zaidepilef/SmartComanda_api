# =========================================
# SmartComanda API - Environment variables
# Copy this file to .env and fill in values
# =========================================

# development | production
NODE_ENV=development

# API port
PORT=3000

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/smartcomanda

# JWT signing secret (minimum 32 characters). REQUIRED.
JWT_SECRET=change_me_to_a_random_secret_of_at_least_32_chars

# JWT token lifetime (e.g. 1h, 24h, 7d)
JWT_EXPIRES_IN=1h

# Cloudflare Turnstile secret key for public registration.
# If empty, public registration will reject all captcha tokens.
TURNSTILE_SECRET_KEY=

# Email of the system administrator
SYSADMIN_EMAIL=fel.di.rod@gmail.com

# Expose Swagger UI at /api/docs (default: true outside production)
ENABLE_API_DOCS=true