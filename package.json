{
  "name": "smartcomanda-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test 'tests/**/*.test.js'",
    "db:import-identity": "node src/db/importIdentity.cli.js",
    "db:import-branches": "node src/db/importBranches.cli.js",
    "db:up": "bash ../scripts/db-up.sh",
    "db:down": "bash ../scripts/db-down.sh",
    "db:status": "bash ../scripts/db-status.sh",
    "db:backup:local": "bash ../scripts/db-backup-local.sh",
    "db:restore:local": "bash ../scripts/db-restore-local.sh",
    "db:backup:atlas": "bash ../scripts/db-backup-atlas.sh",
    "db:restore:atlas": "bash ../scripts/db-restore-atlas.sh"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.5.0",
    "pg": "^8.16.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  }
}
